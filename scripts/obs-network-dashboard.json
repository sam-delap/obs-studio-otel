{
  "title": "OBS Studio — Stream Health & Network",
  "description": "Network and stream-health metrics scraped from the OBS WebSocket and emitted as obs.scrape log events by obs-studio-otel. Visualizes congestion, throughput, dropped/skipped frames, and supporting render/system stats.",
  "tags": ["obs", "obs-studio", "streaming", "network", "obs-studio-otel"],
  "layout": [
    { "i": "w-output-active", "x": 0, "y": 0, "w": 12, "h": 6, "moved": false, "static": false },
    { "i": "w-congestion", "x": 0, "y": 6, "w": 4, "h": 4, "moved": false, "static": false },
    { "i": "w-dropped-pct", "x": 4, "y": 6, "w": 4, "h": 4, "moved": false, "static": false },
    { "i": "w-bytes-rate", "x": 0, "y": 10, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-congestion-ts", "x": 6, "y": 10, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-dropped-pct-ts", "x": 0, "y": 16, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-frames", "x": 6, "y": 16, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-dropped-vs-reconnect", "x": 0, "y": 22, "w": 12, "h": 6, "moved": false, "static": false },
    { "i": "w-fps", "x": 0, "y": 28, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-render-time", "x": 6, "y": 28, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-scrape-health", "x": 0, "y": 34, "w": 12, "h": 6, "moved": false, "static": false }
  ],
  "variables": {},
  "widgets": [
    {
      "id": "w-output-active",
      "title": "Stream Output Active",
      "description": "Whether the OBS stream output is active over time (1 = streaming, 0 = idle). Emitted as a 0/1 integer.",
      "panelTypes": "graph",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_active", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "output active",
              "disabled": false,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
      "id": "w-congestion",
      "title": "Network Congestion (current)",
      "description": "OBS output network congestion as a percentage (raw 0.0–1.0 value × 100, computed at query time). Sustained high values indicate the encoder cannot push data fast enough.",
      "panelTypes": "value",
      "yAxisUnit": "percent",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "avg",
              "timeAggregation": "avg",
              "spaceAggregation": "avg",
              "aggregateAttribute": { "key": "obs.stream.output_congestion", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "congestion",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "last"
            }
          ],
          "queryFormulas": [
            { "queryName": "F1", "expression": "A * 100", "legend": "congestion %", "disabled": false, "reduceTo": "last" }
          ]
        }
      }
    },
