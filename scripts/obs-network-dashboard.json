  "title": "OBS Studio — Stream Failure Modes",
  "variables": {},
  "version": "v5",
  "widgets": [
    {
      "description": "Top-level failure signal: percentage of stream-output frames dropped (obs.stream.output_skipped_frames / obs.stream.output_total_frames × 100), computed at query time. Any sustained rise means the stream is failing; the Mode 1/2/3 panels below explain why.",
      "id": "w-overview-dropped",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "expression": "max(obs.stream.output_skipped_frames)"
                }
              ],
              "dataSource": "logs",
              "disabled": true,
              "expression": "A",
              "filter": {
                "expression": "service.name = 'obs-studio-scraper'"
              },
              "groupBy": [],
              "having": {
                "expression": ""
              },
              "legend": "skipped frames",
              "limit": null,
              "orderBy": [],
              "queryName": "A",
              "stepInterval": 60
            },
            {
              "aggregations": [
                {
                  "expression": "max(obs.stream.output_total_frames)"
                }
              ],
              "dataSource": "logs",
              "disabled": true,
              "expression": "B",
              "filter": {
                "expression": "service.name = 'obs-studio-scraper'"
              },
              "groupBy": [],
              "having": {
                "expression": ""
              },
              "legend": "total frames",
              "limit": null,
              "orderBy": [],
              "queryName": "B",
              "stepInterval": 60
            }
          ],
          "queryFormulas": [
            {
              "disabled": false,
              "expression": "A / B * 100",
              "legend": "dropped %",
              "queryName": "F1",
              "reduceTo": "avg"
            }
          ]
        },
        "queryType": "builder"
      },
      "title": "Frames Dropped on the Wire (%)",
      "yAxisUnit": "percent"
    },
