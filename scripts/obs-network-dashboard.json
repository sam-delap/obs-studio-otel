      "panelTypes": "graph",
      "yAxisUnit": "percent",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stats.output_skipped_frames", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "skipped frames",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            },
            {
              "queryName": "B",
