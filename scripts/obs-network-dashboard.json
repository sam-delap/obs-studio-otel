{
  "title": "OBS Studio — Stream Failure Modes",
  "description": "Scoped to the three ways an OBS→YouTube stream drops frames: (1) internal network congestion exceeding OBS's send buffer, (2) the YouTube endpoint disconnecting, and (3) OBS itself failing to send frames. All series derive from obs.scrape and obs.stream_state_changed log events emitted by obs-studio-otel. General health / built-in-editor metrics (render-thread frames, FPS, render time, memory, bytes) are intentionally excluded.",
  "tags": ["obs", "obs-studio", "streaming", "network", "failure-modes", "obs-studio-otel"],
  "layout": [
    { "i": "w-overview-dropped", "x": 0, "y": 0, "w": 12, "h": 6, "moved": false, "static": false },
    { "i": "w-mode1-congestion", "x": 0, "y": 6, "w": 8, "h": 6, "moved": false, "static": false },
    { "i": "w-mode1-current", "x": 8, "y": 6, "w": 4, "h": 6, "moved": false, "static": false },
    { "i": "w-mode2-reconnect", "x": 0, "y": 12, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-mode2-events", "x": 6, "y": 12, "w": 6, "h": 6, "moved": false, "static": false },
    { "i": "w-mode3-send", "x": 0, "y": 18, "w": 8, "h": 6, "moved": false, "static": false },
    { "i": "w-mode3-current", "x": 8, "y": 18, "w": 4, "h": 6, "moved": false, "static": false }
  ],
  "variables": {},
  "widgets": [
    {
      "id": "w-overview-dropped",
      "title": "Frames Dropped on the Wire (%)",
      "description": "Top-level failure signal: percentage of stream-output frames dropped (obs.stream.output_skipped_frames / obs.stream.output_total_frames × 100), computed at query time. Any sustained rise means the stream is failing; the Mode 1/2/3 panels below explain why.",
      "panelTypes": "graph",
      "yAxisUnit": "percent",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_skipped_frames", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "skipped frames",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            },
            {
              "queryName": "B",
              "expression": "B",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_total_frames", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "total frames",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            }
          ],
          "queryFormulas": [
            { "queryName": "F1", "expression": "A / B * 100", "legend": "dropped %", "disabled": false, "reduceTo": "avg" }
          ]
        }
      }
    },
    {
      "id": "w-mode1-congestion",
      "title": "Mode 1: Network Congestion / Buffer Saturation",
      "description": "Internal network congestion exceeding OBS's send buffer. Overlays output congestion as a percent (obs.stream.output_congestion × 100) with the reconnecting state (0/1). Congestion saturating toward 100% WHILE reconnecting stays 0 means the local/internal network cannot drain OBS's buffer fast enough — distinct from a YouTube disconnect (Mode 2).",
      "panelTypes": "graph",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "avg",
              "timeAggregation": "avg",
              "spaceAggregation": "avg",
              "aggregateAttribute": { "key": "obs.stream.output_congestion", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "congestion",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            },
            {
              "queryName": "C",
              "expression": "C",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_reconnecting", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "reconnecting (0/1)",
              "disabled": false,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            }
          ],
          "queryFormulas": [
            { "queryName": "F1", "expression": "A * 100", "legend": "congestion %", "disabled": false, "reduceTo": "avg" }
          ]
        }
      }
    },
    {
      "id": "w-mode1-current",
      "title": "Mode 1: Congestion (current)",
      "description": "Current OBS output congestion as a percentage (obs.stream.output_congestion × 100). A value approaching 100% indicates OBS's send buffer is saturating against the internal network.",
      "panelTypes": "value",
      "yAxisUnit": "percent",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "avg",
              "timeAggregation": "avg",
              "spaceAggregation": "avg",
              "aggregateAttribute": { "key": "obs.stream.output_congestion", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "congestion",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "last"
            }
          ],
          "queryFormulas": [
            { "queryName": "F1", "expression": "A * 100", "legend": "congestion %", "disabled": false, "reduceTo": "last" }
          ]
        }
      }
    },
    {
      "id": "w-mode2-reconnect",
      "title": "Mode 2: YouTube Endpoint Disconnects (sampled)",
      "description": "Overlays the reconnecting state (obs.stream.output_reconnecting, 0/1) with wire-dropped % (obs.stream.output_skipped_frames / obs.stream.output_total_frames × 100). Reconnect spikes coincident with dropped frames indicate the upstream RTMPS endpoint (YouTube) dropped the connection. This is the periodic-sample view; the events panel beside it catches reconnects between samples.",
      "panelTypes": "graph",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_skipped_frames", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "skipped frames",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            },
            {
              "queryName": "B",
              "expression": "B",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_total_frames", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "total frames",
              "disabled": true,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            },
            {
              "queryName": "C",
              "expression": "C",
              "dataSource": "logs",
              "aggregateOperator": "max",
              "timeAggregation": "max",
              "spaceAggregation": "max",
              "aggregateAttribute": { "key": "obs.stream.output_reconnecting", "dataType": "float64", "type": "attribute", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" } ] },
              "groupBy": [],
              "having": [],
              "legend": "reconnecting (upstream RTMPS)",
              "disabled": false,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "avg"
            }
          ],
          "queryFormulas": [
            { "queryName": "F1", "expression": "A / B * 100", "legend": "dropped %", "disabled": false, "reduceTo": "avg" }
          ]
        }
      }
    },
    {
      "id": "w-mode2-events",
      "title": "Mode 2: Stream State Transitions (events)",
      "description": "Count of obs.stream_state_changed log events grouped by obs.stream.output_state. Event-driven, so it captures short reconnects that occur between scrape samples (OBS_WEBSOCKET_OUTPUT_RECONNECTING / _RECONNECTED / _STOPPED). The state string is used only as a group-by dimension (one series per state), never aggregated as a number.",
      "panelTypes": "graph",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "logs",
              "aggregateOperator": "count",
              "timeAggregation": "count",
              "spaceAggregation": "sum",
              "aggregateAttribute": { "key": "", "dataType": "", "type": "", "isColumn": false },
              "filters": { "op": "AND", "items": [ { "key": { "key": "service.name", "dataType": "string", "type": "resource", "isColumn": true }, "op": "=", "value": "obs-studio-scraper" }, { "key": { "key": "obs.stream.output_state", "dataType": "string", "type": "tag", "isColumn": false }, "op": "exists", "value": "" } ] },
              "groupBy": [ { "key": "obs.stream.output_state", "dataType": "string", "type": "tag", "isColumn": false } ],
              "having": [],
              "legend": "{{obs.stream.output_state}}",
              "disabled": false,
              "stepInterval": 60,
              "orderBy": [],
              "limit": null,
              "reduceTo": "sum"
            }
          ],
          "queryFormulas": []
        }
      }
    },
    {
