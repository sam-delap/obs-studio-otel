# The image version is supplied via the
# SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OBS_STUDIO_OTEL build-arg; the build does
# not read git, so .git is not needed in the build context.
.git/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# setuptools_scm generated version file (regenerated during build)
src/obs_otel/_version.py

# Virtual environments
.venv/
venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Project meta not needed in the image
.github/
.gitignore
.dockerignore
.releaserc.yml
